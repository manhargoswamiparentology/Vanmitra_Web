generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  city         String?
  isAdmin      Boolean  @default(false)
  isCorporate  Boolean  @default(false)
  companyName  String?
  createdAt    DateTime @default(now())

  dedications  Dedication[]
  notes        Note[]
  visits       Visit[]
  userBadges   UserBadge[]
  reservations InventoryTree[] @relation("ReservedBy")

  @@map("users")
}

// ─── Inventory (admin-created physical trees on the farm) ─────────────────────

model InventoryTree {
  id               String              @id @default(cuid())
  uniqueId         String              @unique   // VM-1747123456789
  speciesId        String
  plotBlock        String?
  plotRow          String?
  plotPosition     String?
  locationAddress  String?             // Human-readable address e.g. "Block C, Vasna Village, Kheda, Gujarat"
  gpsLat           Float?
  gpsLng           Float?
  price            Int                 @default(500)  // rupees
  notes            String?             // admin notes about this physical tree
  healthStatus     String              @default("healthy")
  heightCm         Int?
  qrCodeData       String?             // QR payload (URL to tree page)
  status           InventoryStatus     @default(DRAFT)
  reservedAt       DateTime?
  reservedUntil    DateTime?           // reservedAt + 5 min
  reservedByUserId String?
  addedAt          DateTime            @default(now())
  addedBy          String?             // admin name

  reservedBy       User?               @relation("ReservedBy", fields: [reservedByUserId], references: [id])
  dedication       Dedication?
  photos           TreePhoto[]
  updates          TreeUpdate[]

  @@map("inventory_trees")
}

enum InventoryStatus {
  DRAFT       // Added in admin — not yet planted / invisible to users
  FREE        // Planted, ID assigned, available for users to dedicate
  RESERVED    // Held by a user (5-min window)
  ALLOCATED   // Purchased / dedicated
}

// ─── Dedication (user's booking linked to one InventoryTree) ──────────────────

model Dedication {
  id            String           @id @default(cuid())
  treeId        String           @unique
  userId        String
  occasionId    String
  recipientName String
  recipientFrom String?
  message       String?
  preferredDate DateTime?
  status        DedicationStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  // Corporate fields
  corporateName  String?          // company name (copied from user at creation)
  employeeEmail  String?          // employee's email (for certificate sharing)
  employeePhone  String?          // employee's phone with country code
  // Public share
  shareToken     String?          @unique  // random token for public /certificate/[token] URL

  tree          InventoryTree    @relation(fields: [treeId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
  notes         Note[]
  certificates  Certificate[]

  @@map("dedications")
}

enum DedicationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ─── Tree Photos & Updates (from admin) ───────────────────────────────────────

model TreePhoto {
  id          String        @id @default(cuid())
  treeId      String
  url         String
  caption     String?
  takenAt     DateTime      @default(now())
  uploadedBy  String?

  tree        InventoryTree @relation(fields: [treeId], references: [id])

  @@map("tree_photos")
}

model TreeUpdate {
  id          String        @id @default(cuid())
  treeId      String
  message     String
  photoUrl    String?
  createdAt   DateTime      @default(now())
  createdBy   String?

  tree        InventoryTree @relation(fields: [treeId], references: [id])

  @@map("tree_updates")
}

model Certificate {
  id            String     @id @default(cuid())
  dedicationId  String
  qrCodeData    String?
  createdAt     DateTime   @default(now())

  dedication    Dedication @relation(fields: [dedicationId], references: [id])

  @@map("certificates")
}

// ─── Gamification ─────────────────────────────────────────────────────────────

model Badge {
  id             String    @id @default(cuid())
  key            String    @unique
  name           String
  description    String
  tier           BadgeTier
  icon           String
  treesRequired  Int?
  streakRequired Int?

  userBadges  UserBadge[]

  @@map("badges")
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  progress  Int      @default(0)

  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─── Notes & Visits ───────────────────────────────────────────────────────────

model Note {
  id           String     @id @default(cuid())
  userId       String
  dedicationId String?
  title        String
  body         String
  mood         NoteMood   @default(REFLECTION)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id])
  dedication   Dedication? @relation(fields: [dedicationId], references: [id])

  @@map("notes")
}

enum NoteMood {
  JOY
  REFLECTION
  ANTICIPATION
}

model Visit {
  id          String   @id @default(cuid())
  userId      String
  visitDate   DateTime
  duration    String?
  companions  String?
  note        String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@map("visits")
}

// ─── Blog ─────────────────────────────────────────────────────────────────────

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  tag         String
  title       String
  excerpt     String
  content     String   @default("")
  readTime    String
  authorName  String   @default("Vanamitra Team")
  publishedAt DateTime @default(now())

  @@map("blog_posts")
}

// ─── Corporate Enquiries ──────────────────────────────────────────────────────

model CorporateEnquiry {
  id        String   @id @default(cuid())
  company   String
  contact   String
  email     String
  phone     String?
  employees String?  // e.g. "100 employees"
  occasion  String?  // e.g. "Diwali 2026"
  message   String?
  status    String   @default("new")  // new | read | replied
  createdAt DateTime @default(now())

  @@map("corporate_enquiries")
}

// ─── Waitlist ─────────────────────────────────────────────────────────────────

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  note      String?
  createdAt DateTime @default(now())

  @@map("waitlist")
}
